# MySQL
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/twebtoon

# Firebase — path to service account JSON (ใช้แค่ verify ID token ตอน login)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# Firebase Realtime Database URL (ใช้แค่ตอนรัน migrate_firebase.py)
FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.firebaseio.com

# SlipOK
SLIPOK_API_KEY=your_slipok_api_key
SLIPOK_ENDPOINT=https://api.slipok.com/api/line/apikey/54127

# Storage (local upload dir)
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# JWT — ต้องเปลี่ยนเป็น random string ที่แข็งแกร่งก่อน deploy production
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
